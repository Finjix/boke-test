# Doubao Seed 原视频分析（活动链路的前置节点）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-0-lite-260428
# Doubao analysis input: base64 avoids the temporary public video upload.
# Use url only when the source exceeds Ark's Base64 request limit.
DOUBAO_VIDEO_INPUT_MODE=base64
# Seedream model is fixed in code for generated storyboard references.
# SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628

# MiniMax H3（Doubao 分析完成后使用）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_RESOLUTION=768P
MINIMAX_TASK_TIMEOUT=7200

# 以下字段仅为旧版 Seedance checkpoint/兼容调用保留
SEEDANCE_MODEL_ID=
SEEDANCE_MAX_DURATION=30
SEEDANCE_TASK_TIMEOUT=7200

# Uguu temporary upload (internal Provider; not exposed in the desktop settings)
UGUU_UPLOAD_URL=https://uguu.se/upload
UGUU_MAX_FILE_MIB=128
UGUU_EXPIRE_HOURS=3

# Runtime
HTTP_TIMEOUT=180
POLL_INTERVAL=10
MAX_RETRIES=3
WORK_DIR=./work
# Used for input and generated-output metadata validation.
FFPROBE_BIN=tools/ffmpeg/bin/ffprobe.exe
