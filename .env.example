# Ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-0-lite-260215

# Must come from the current Ark console account; do not guess the ID.
SEEDANCE_MODEL_ID=
SEEDANCE_MAX_DURATION=30
SEEDANCE_TASK_TIMEOUT=7200

# AI MediaKit
MEDIAKIT_API_KEY=

# Seed-Audio 1.0; the model name is fixed by the application.
SEED_AUDIO_API_KEY=
SEED_AUDIO_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/create
SEED_AUDIO_MODEL=seed-audio-1.0

# Uguu temporary upload
UGUU_UPLOAD_URL=https://uguu.se/upload
UGUU_MAX_FILE_MIB=128
UGUU_EXPIRE_HOURS=3

# Runtime
HTTP_TIMEOUT=180
POLL_INTERVAL=10
MAX_RETRIES=3
WORK_DIR=./work
# Prefer the binaries installed under this project.
FFMPEG_BIN=tools/ffmpeg/bin/ffmpeg.exe
FFPROBE_BIN=tools/ffmpeg/bin/ffprobe.exe
MEDIAKIT_CLI_BIN=tools/mediakit/mediakit-cli.exe
