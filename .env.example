# MiniMax H3-Context-IR and H3 video generation
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_RESOLUTION=768P
MINIMAX_TASK_TIMEOUT=7200

# Uguu temporary public URL upload for MiniMax reference_video input
UGUU_UPLOAD_URL=https://uguu.se/upload
UGUU_MAX_FILE_MIB=50
UGUU_EXPIRE_HOURS=3

# Runtime
HTTP_TIMEOUT=180
POLL_INTERVAL=10
WORK_DIR=./work
FFPROBE_BIN=tools/ffmpeg/bin/ffprobe.exe
