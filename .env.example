# MiniMax H3（活动链路只使用这一组凭证）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_RESOLUTION=2K
MINIMAX_TASK_TIMEOUT=7200

# 以下字段仅为旧版 Doubao/Seedance checkpoint 兼容保留，不会被 H3 默认链路使用
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-0-lite-260428

# Must come from the current Ark console account; do not guess the ID.
SEEDANCE_MODEL_ID=
SEEDANCE_MAX_DURATION=30
SEEDANCE_TASK_TIMEOUT=7200

# Uguu temporary upload (internal Provider; not exposed in the desktop settings)
UGUU_UPLOAD_URL=https://uguu.se/upload
UGUU_MAX_FILE_MIB=128
UGUU_EXPIRE_HOURS=3

# Runtime
HTTP_TIMEOUT=180
POLL_INTERVAL=10
MAX_RETRIES=3
WORK_DIR=./work
# Used for input and generated-output metadata validation.
FFPROBE_BIN=tools/ffmpeg/bin/ffprobe.exe
